# Public URL for this Executor instance.
EXECUTOR_WEB_BASE_URL=https://executor.example.com
EXECUTOR_AUTH_PROVIDER=workos-authkit

# WorkOS AuthKit application and server API credentials.
WORKOS_API_KEY=sk_example
WORKOS_CLIENT_ID=client_example
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-characters
WORKOS_AUTHKIT_DOMAIN=https://example.authkit.app
WORKOS_REDIRECT_URI=https://executor.example.com/api/auth/callback

# Optional WorkOS API override for emulators or private routing.
# WORKOS_API_URL=https://api.workos.com

# Restrict this deployment to one or more WorkOS organizations. Leave both
# unset only when the instance is intentionally multi-organization.
WORKOS_SERVICE_ORGANIZATION_ID=org_platform
# WORKOS_ALLOWED_ORGANIZATION_IDS=org_example,org_second

# Public WorkOS Connect application used by `executor login` device auth.
# WORKOS_CLI_CLIENT_ID=client_cli_example
# WORKOS_CONNECT_AUDIENCE=client_example
# WORKOS_MCP_SCOPES=openid profile email offline_access

# WorkOS service identity and Manifest Trigger credential leasing. Only listed
# M2M applications owned by the platform service organization are accepted.
# Each request names its customer organization explicitly and carries the
# initiating workspace/run context plus the required lease scope.
# WORKOS_M2M_ALLOWED_CLIENT_IDS=client_manifest_trigger
# WORKOS_CREDENTIAL_LEASE_SCOPE=credentials:lease
# EXECUTOR_CREDENTIAL_LEASE_DEFAULT_TTL_SECONDS=3600
# EXECUTOR_CREDENTIAL_LEASE_MAX_TTL_SECONDS=3600

# Executor credential encryption. When unset, a key is generated under /data.
# EXECUTOR_SECRET_KEY=

# Sandboxed code cannot reach private addresses unless explicitly enabled.
# EXECUTOR_ALLOW_LOCAL_NETWORK=false
